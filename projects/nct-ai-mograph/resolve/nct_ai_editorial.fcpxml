  <library>
    <event name="NCT_AI_Enterprise_Mograph_Event">
      <project name="NCT_AI_Enterprise_Mograph">
        <sequence format="r1" duration="360/30s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
          <spine>
            <asset-clip name="NCT_Beat1_HAD_Compression" ref="r2" offset="0/30s" start="0s" duration="90/30s" format="r1">
              <asset-clip name="SFX_Sub_Thud_Intro" ref="r3" lane="-1" offset="3/30s" start="0s" duration="10/30s" role="effects" />
              <asset-clip name="SFX_HAD_Lock" ref="r4" lane="-1" offset="64/30s" start="0s" duration="5/30s" role="effects">
                <adjust-volume amount="1.0dB" />
              </asset-clip>
              <asset-clip name="SFX_BGP_Whoosh" ref="r5" lane="-1" offset="90/30s" start="0s" duration="13/30s" role="effects" />
              <asset-clip name="SFX_CRM_Thud" ref="r3" lane="-1" offset="186/30s" start="0s" duration="10/30s" role="effects">
                <adjust-volume amount="0.5dB" />
              </asset-clip>
              <asset-clip name="SFX_Lockup_Stinger" ref="r6" lane="-1" offset="282/30s" start="0s" duration="14/30s" role="effects">
                <adjust-volume amount="1.0dB" />
              </asset-clip>
              <asset-clip name="Master_Editorial_Mix" ref="r7" lane="-2" offset="0/30s" start="0s" duration="360/30s" role="effects" />
            </asset-clip>
            <asset-clip name="NCT_Beat2_Carrier_BGP_Matrix" ref="r2" offset="90/30s" start="0s" duration="96/30s" format="r1" />
            <asset-clip name="NCT_Beat3_CRM_Wallboard_Zoom" ref="r2" offset="186/30s" start="0s" duration="96/30s" format="r1">
              <adjust-transform scale="1.15 1.15" />
            </asset-clip>
            <asset-clip name="NCT_Beat4_Architecture_Lockup" ref="r2" offset="282/30s" start="0s" duration="78/30s" format="r1" />
          </spine>
        </sequence>
      </project>
    </event>
  </library>
